{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "focusboard/app-document.v1.schema.json",
  "title": "Focusboard AppDocument v1",
  "description": "Persisted shape of focusboard.json. In code, this is generated from the Zod schema in src/domain/schema.ts (z.toJSONSchema) — this file is the reviewed contract snapshot.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "board", "pomodoro", "prefs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "board": { "$ref": "#/$defs/Board" },
    "pomodoro": { "$ref": "#/$defs/PomodoroState" },
    "prefs": { "$ref": "#/$defs/Preferences" }
  },
  "$defs": {
    "Uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "EstimateMin": {
      "oneOf": [
        { "type": "null" },
        { "type": "integer", "minimum": 1, "maximum": 5940 }
      ]
    },
    "Accent": { "enum": ["orange", "mint", "pink", "yellow", "violet", "sky"] },
    "Board": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sections", "connections", "viewport"],
      "properties": {
        "sections": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/Section" } },
        "connections": { "type": "array", "items": { "$ref": "#/$defs/Connection" } },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "zoom"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "zoom": { "type": "number", "minimum": 0.25, "maximum": 2 }
          }
        }
      }
    },
    "Section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "accent", "x", "y", "width", "height", "tasks", "createdAt"],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "title": { "type": "string", "maxLength": 120 },
        "accent": { "$ref": "#/$defs/Accent" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "minimum": 240 },
        "height": { "type": "number", "minimum": 160 },
        "tasks": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/Task" } },
        "createdAt": { "type": "integer", "minimum": 0 }
      }
    },
    "Task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "done", "estimateMin", "subtasks"],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "text": { "type": "string", "maxLength": 500 },
        "done": { "type": "boolean" },
        "estimateMin": { "$ref": "#/$defs/EstimateMin" },
        "subtasks": { "type": "array", "items": { "$ref": "#/$defs/Subtask" } }
      }
    },
    "Subtask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "done", "estimateMin"],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "text": { "type": "string", "maxLength": 500 },
        "done": { "type": "boolean" },
        "estimateMin": { "$ref": "#/$defs/EstimateMin" }
      }
    },
    "Connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "style", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "from": { "$ref": "#/$defs/Uuid" },
        "to": { "$ref": "#/$defs/Uuid" },
        "style": { "enum": ["arrow", "line"] },
        "label": { "type": "string", "maxLength": 40 }
      }
    },
    "TimerStatus": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["kind"],
          "properties": { "kind": { "const": "idle" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "endsAt"],
          "properties": { "kind": { "const": "running" }, "endsAt": { "type": "integer", "minimum": 0 } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "remainingMs"],
          "properties": { "kind": { "const": "paused" }, "remainingMs": { "type": "integer", "minimum": 0 } }
        }
      ]
    },
    "PomodoroState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["settings", "mode", "status", "sessionId", "focusStreak", "completedToday", "linkedTaskId", "widget"],
      "properties": {
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["focusMin", "shortBreakMin", "longBreakMin", "longBreakEvery", "sound"],
          "properties": {
            "focusMin": { "type": "integer", "minimum": 1, "maximum": 120 },
            "shortBreakMin": { "type": "integer", "minimum": 1, "maximum": 60 },
            "longBreakMin": { "type": "integer", "minimum": 1, "maximum": 90 },
            "longBreakEvery": { "type": "integer", "minimum": 2, "maximum": 10 },
            "sound": { "type": "boolean" }
          }
        },
        "mode": { "enum": ["focus", "shortBreak", "longBreak"] },
        "status": { "$ref": "#/$defs/TimerStatus" },
        "sessionId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Uuid" }] },
        "focusStreak": { "type": "integer", "minimum": 0 },
        "completedToday": {
          "type": "object",
          "additionalProperties": false,
          "required": ["date", "count"],
          "properties": {
            "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "count": { "type": "integer", "minimum": 0 }
          }
        },
        "linkedTaskId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Uuid" }] },
        "widget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "visible"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "visible": { "type": "boolean" }
          }
        }
      }
    },
    "Preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theme", "pinned"],
      "properties": {
        "theme": { "enum": ["system", "light", "dark"] },
        "pinned": { "type": "boolean" }
      }
    }
  }
}
