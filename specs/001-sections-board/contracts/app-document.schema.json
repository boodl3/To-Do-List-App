        "mode": {
          "type": "string",
          "enum": [
            "focus",
            "shortBreak",
            "longBreak"
          ]
        },
        "status": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "idle"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
