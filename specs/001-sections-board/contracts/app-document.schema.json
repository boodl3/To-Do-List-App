            "height": {
              "type": "number",
              "minimum": 120,
              "maximum": 640
            },
            "visible": {
              "type": "boolean"
            }
          },
          "required": [
            "x",
            "y",
            "width",
            "height",
            "visible"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "settings",
        "mode",
        "status",
        "sessionId",
        "focusStreak",
        "completedToday",
        "linkedTaskId",
        "widget"
      ],
      "additionalProperties": false
